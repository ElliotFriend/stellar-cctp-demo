{
    "name": "cctp-demo",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write . && cargo fmt",
        "gen:solana-cctp": "node scripts/gen-solana-cctp.mjs"
    },
    "devDependencies": {
        "@codama/nodes-from-anchor": "^1.5.6",
        "@codama/renderers-js": "^2.5.0",
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "@sveltejs/adapter-static": "^4.0.0",
        "@sveltejs/kit": "^3.0.1",
        "@sveltejs/load-config": "^0.2.2",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@types/node": "^24.19.1",
        "codama": "^1.11.0",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.23.1",
        "globals": "^17.13.0",
        "prettier": "^3.9.9",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.6",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.3.4"
    },
    "dependencies": {
        "@solana-program/token": "^0.17.0",
        "@solana/kit": "^8.4.0",
        "@stellar/freighter-api": "^6.0.1",
        "@stellar/stellar-sdk": "^17.2.1",
        "@wallet-standard/app": "^1.1.1",
        "@wallet-standard/base": "^1.1.1",
        "tslib": "^2.8.1",
        "viem": "^2.57.4"
    },
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    }
