# Mainnet. Selected with `--mode mainnet` (`pnpm dev:mainnet`,
# `pnpm build:mainnet`). Every value here is public. These move real funds.
PUBLIC_NETWORK="mainnet"

# Circle attestation service
PUBLIC_IRIS_API="https://iris-api.circle.com"

# Stellar (SDF runs no public mainnet RPC; this is an ecosystem provider)
